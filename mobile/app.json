{
  "expo": {
    "name": "SoftTime",
    "slug": "softtime",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/softtime-white.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/softtime-white.png",
      "resizeMode": "contain",
      "backgroundColor": "#1877F2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.softtime.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera"
      }
    },
    "android": {
      "icon": "./assets/softtime-white.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#1877F2"
      },
      "package": "com.softtime.mobile",
      "userInterfaceStyle": "light",
      "newArchEnabled": true,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "react-native-vision-camera",
      "expo-font",
      "expo-secure-store",
      "expo-updates"
    ],
    "extra": {
      "eas": {
        "projectId": "2eab1e92-daac-4edb-96a1-7a9c0966d375"
      }
    },
    "owner": "emilbek"
  }
}
